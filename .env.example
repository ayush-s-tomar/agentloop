# Copy this file to .env and fill in your own keys. Never commit real keys.

# Groq (LLM): free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily (web search tool): free key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Models (optional)
GROQ_REASON_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Caps that keep runs bounded (optional)
MAX_SUBQUESTIONS=4
MAX_REFLECT_ADDITIONS=3

# Optional tracing to Postgres (Supabase). Leave empty to disable tracing.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Max research runs per IP per hour (protects the public demo's API quota)
RATE_LIMIT_RUNS=5
